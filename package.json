{
  "name": "festival-camping",
  "version": "1.0.0",
  "description": "Backend para la gestión de reservas de carpas en las zonas de camping - Festival Picnic 2026",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --ext ts,json --exec 'tsx ./src/app.ts'",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "start": "node dist/app.js",
    "sync": "npx prisma db pull && npx prisma generate",
    "test": "node pruebas/correr.mjs camping http://localhost:3000",
    "test:suite": "node tests/suite-completa.mjs"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "clean-architecture",
    "festival-picnic-2026"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}